{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/vue-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "croustibat/filament-jobs-monitor": "4.5.*",
        "filament/filament": "^5.6",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/ai": "^0.9",
        "laravel/fortify": "^1.30",
        "laravel/framework": "^12.0",
        "laravel/nightwatch": "^1.28",
        "laravel/octane": "^2.17",
        "laravel/socialite": "^5.23",
        "laravel/tinker": "^2.10.1",
        "laravel/wayfinder": "^0.1.9",
        "league/flysystem-aws-s3-v3": "^3.0",
        "matondojk/filament-avatar-picker": "^2.0",
        "phpoffice/phpword": "^1.4",
        "pusher/pusher-php-server": "^7.3",
        "smalot/pdfparser": "^2.12"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "*",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "docker:start": [
            "docker compose up -d --build"
        ],
        "docker:down": [
            "docker compose down"
        ],
        "dev:ssr": [
            "npm run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr --kill-others"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@php -r \"echo '>>> STEP 1: npm run lint:check\n'; passthru('npm run lint:check', \$c); if (\$c !== 0) exit(\$c);\"",
            "@php -r \"echo '>>> STEP 2: npm run format:check\n'; passthru('npm run format:check', \$c); if (\$c !== 0) exit(\$c);\"",
            "@php -r \"echo '>>> STEP 3: npm run types:check\n'; passthru('npm run types:check', \$c); if (\$c !== 0) exit(\$c);\"",
            "@php -r \"echo '>>> STEP 4: npm run test:js\n'; passthru('npm run test:js', \$c); if (\$c !== 0) exit(\$c);\"",
            "@php -r \"echo '>>> STEP 5: @test\n'; passthru('composer test', \$c); if (\$c !== 0) exit(\$c);\""
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@php artisan test"
        ],
        "test:preflight": [
            "Composer\\Config::disableProcessTimeout",
            "sh bin/test-preflight.sh"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
