APP_NAME=LSI
APP_ENV=production
APP_KEY=generate-a-unique-key
APP_DEBUG=false
APP_URL=https://your-domain.example
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ── Database (PostgreSQL) ────────────────────────────────────────────────
# The docker-compose.production.yml stack provisions a Postgres service named
# "db"; these values must match the POSTGRES_* variables in that file.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=change-me

# ── Sessions / queue / cache ─────────────────────────────────────────────
# Sessions and cache stay database-backed. The queue runs on Redis (the
# compose stack provisions a `redis` service) and is supervised by Laravel
# Horizon — installed into the Docker image only, never in composer.json.
# The `octane` container role runs the web server AND the queue consumer
# (Horizon on Redis, `php artisan queue:work` otherwise) together.
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=database
CACHE_PREFIX="${APP_NAME}"

# ── Real-time exam autosave (Pusher Channels) ────────────────────────────
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=your-pusher-app-id
PUSHER_APP_KEY=your-pusher-app-key
PUSHER_APP_SECRET=your-pusher-app-secret
PUSHER_APP_CLUSTER=ap1
PUSHER_PORT=443
PUSHER_SCHEME=https

# ── Octane (FrankenPHP) web server + queue consumer ──────────────────────
# The `octane` role starts the FrankenPHP web server and the queue consumer
# together under Supervisor in the same container.
OCTANE_SERVER=frankenphp
PORT=8000
OCTANE_WORKERS=4
OCTANE_MAX_REQUESTS=500
OCTANE_ADMIN_PORT=2019

# ── Queue workers (Laravel Horizon supervisor) ─────────────────────────────
# Horizon watches the "ai" queue plus "default". When QUEUE_CONNECTION is
# not redis, the same container instead runs `php artisan queue:work` using
# QUEUE_NAME / QUEUE_WORKER_PROCESSES / QUEUE_TRIES / QUEUE_TIMEOUT.
QUEUE_NAME=ai
QUEUE_WORKER_PROCESSES=4
QUEUE_TRIES=3
QUEUE_TIMEOUT=300
HORIZON_QUEUES=ai,default
HORIZON_PROCESSES=4
HORIZON_TRIES=3
HORIZON_TIMEOUT=300
HORIZON_MEMORY=128

# ── R2 (Cloudflare) object storage ───────────────────────────────────────
FILESYSTEM_DISK=s3
PUBLIC_DISK=s3
AWS_ACCESS_KEY_ID=your-r2-access-key
AWS_SECRET_ACCESS_KEY=your-r2-secret
AWS_DEFAULT_REGION=auto
AWS_BUCKET=your-r2-bucket
AWS_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=https://pub-your-bucket-id.r2.dev

# AWS_URL is the R2 bucket's PUBLIC url: R2 -> bucket -> Settings -> Public
# access -> Enable, then use the https://pub-<id>.r2.dev URL (or a custom
# domain attached to the bucket). PUBLIC_DISK=s3 points the public disk
# (avatars, badges, course covers, school logo, demo video) at R2 so uploads
# survive redeploys.
MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-domain.example
MAIL_FROM_NAME="${APP_NAME}"
