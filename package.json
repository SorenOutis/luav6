        "axios": "^1.17.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dompurify": "^3.4.13",
        "gsap": "^3.15.0",
        "html2pdf.js": "^0.14.0",
        "laravel-vite-plugin": "^2.1.0",
        "lenis": "^1.3.25",
        "lucide-vue-next": "^0.468.0",
        "marked": "^18.0.9",
        "motion": "^12.40.0",
        "pixi.js": "^8.19.0",
        "reka-ui": "^2.9.9",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.0",
        "vue": "^3.5.35",
        "vue-input-otp": "^0.3.2"
