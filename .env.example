APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ── Octane (FrankenPHP) ──────────────────────────────────────────────────
# Used by `php artisan octane:start` and the Docker image entrypoint.
# The Docker `octane` role starts the FrankenPHP web server AND the queue
# consumer together under Supervisor: Laravel Horizon when QUEUE_CONNECTION
# is redis, otherwise a queue:work worker. It keys off PORT, OCTANE_WORKERS,
# OCTANE_MAX_REQUESTS, QUEUE_NAME, QUEUE_WORKER_PROCESSES, QUEUE_TRIES and
# QUEUE_TIMEOUT. When QUEUE_CONNECTION=redis, Docker installs Laravel Horizon
# into the image (never in composer.json) and maps these QUEUE_* values onto
# Horizon's supervisor settings.
OCTANE_SERVER=frankenphp
# PORT=8000
# OCTANE_WORKERS=4
# OCTANE_MAX_REQUESTS=500
# OCTANE_ADMIN_PORT=2019
# QUEUE_NAME=ai
# QUEUE_WORKER_PROCESSES=4
# QUEUE_TRIES=3
# QUEUE_TIMEOUT=300

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# To enable real-time exam answer acknowledgements with Pusher, set
# BROADCAST_CONNECTION=pusher and provide the values below. The app key and
# cluster are rendered to the browser at runtime; the app secret stays server-only.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_PORT=443
PUSHER_SCHEME=https

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# The Docker stack overrides this to redis and runs Laravel Horizon in the
# same container as the web server (installed in the image only, never in
# composer.json). With a non-redis connection (e.g. database) the container
# runs `php artisan queue:work` instead. Local non-Docker dev keeps the
# database queue + the on-demand worker spawner, so nothing extra is needed.
# QUEUE_CONNECTION=redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Set PUBLIC_DISK=s3 to store public uploads (avatars, badges, covers, logo)
# on S3/R2 instead of the local disk. Requires a bucket with public access and
# AWS_URL set to its public URL (e.g. https://pub-<id>.r2.dev).
PUBLIC_DISK=local

# Security headers. Start with report-only, review /csp/report logs, then switch
# SECURITY_CSP_MODE to enforce after all legitimate sources are accounted for.
SECURITY_CSP_MODE=report-only
SECURITY_CSP_REPORT_URI=/csp/report
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
# SECURITY_PERMISSIONS_POLICY="accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()"

# ── Social login (Laravel Socialite) ─────────────────────────────────────
# Google and GitHub are built-in Socialite drivers, so no socialiteproviders/*
# package is needed. Leave a pair blank to hide that button on /login.
# The redirect URIs must match the ones registered with the provider exactly.
#   Google: https://console.cloud.google.com/ -> APIs & Services -> Credentials
#   GitHub: https://github.com/settings/developers -> OAuth Apps
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

# After impersonating a student from Filament, land on their dashboard
# (Inertia) instead of the public welcome page. The admin panel uses SPA
# navigation, so the impersonate action also calls withoutSpa().
FILAMENT_IMPERSONATE_REDIRECT=/dashboard

VITE_APP_NAME="${APP_NAME}"
